
@Metadata.layer: #CORE
@UI.headerInfo.title.type: #STANDARD
@UI.headerInfo.title.value: 'UsageID'
@UI.headerInfo.description.type: #STANDARD
@UI.headerInfo.description.value: 'UsageID'

annotate view ZC_PART_USAGE with
{
  @EndUserText.label: 'UsageID'
  @UI.identification: [{ position: 10, label: 'UsageID' }]
  @UI.lineItem: [
    { position: 10, label: 'UsageID' },
    {
      position: 140,
      label: 'Consume Spare Part',
      type: #FOR_ACTION,
      dataAction: 'consumeSparePart',
      invocationGrouping: #CHANGE_SET
    }
  ]
  @UI.selectionField: [{ position: 10 }]
  UsageId;
  
    @UI.facet: [
    {
      id: 'UsageDetails',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Usage Details',
      position: 10
    }
  ]

  @EndUserText.label: 'OrderID'
